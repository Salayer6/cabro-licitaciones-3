# ──────────────────────────────────────────────────────────────────────────────
# Variables de entorno del Backend - cabro-licitaciones
# ──────────────────────────────────────────────────────────────────────────────
# INSTRUCCIONES:
#   1. Copia este archivo: cp .env.example .env
#   2. Rellena los valores reales (nunca subas .env al repositorio)
#   3. Reinicia el servidor después de cualquier cambio
# ──────────────────────────────────────────────────────────────────────────────

# ── API oficial de Mercado Público (api.mercadopublico.cl) ───────────────────
# Ticket de acceso obligatorio para todos los endpoints de la API REST.
# Cómo obtenerlo:
#   1. Regístrate en https://api.mercadopublico.cl/
#   2. Ve a "Mis Aplicaciones" y genera un nuevo ticket
#   3. Pega el valor aquí (es un UUID con formato: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
MERCADO_PUBLICO_TICKET=TU_TICKET_UUID_AQUI

# ── Entorno de ejecución ─────────────────────────────────────────────────────
# "development" activa logs verbose, browser con cabeza (visible), etc.
# "production"  activa headless, desactiva el app.listen local
NODE_ENV=development

# ── Puerto del servidor (opcional, por defecto: 3001) ────────────────────────
# PORT=3001
